# Application Configuration
APP_NAME="Brightloop Subscription Management API"
APP_ENV="development"
DEBUG=True
API_V1_PREFIX="/api/v1"
SECRET_KEY="temporary-insecure-secret-key-change-in-production"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database Configuration (PostgreSQL)
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="brightloop_user"
POSTGRES_PASSWORD="brightloop_password"
POSTGRES_DB="brightloop_db"
DATABASE_URL="postgresql+asyncpg://brightloop_user:brightloop_password@localhost:5432/brightloop_db"
DATABASE_URL_SYNC="postgresql://brightloop_user:brightloop_password@localhost:5432/brightloop_db"

# CORS Configuration (Allowed origins separated by comma)
BACKEND_CORS_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173"

# Firebase Authentication Configuration
FIREBASE_PROJECT_ID="subscribtionmanagement"
FIREBASE_CREDENTIALS_PATH=""
FIREBASE_CREDENTIALS_JSON=""
# GOOGLE_APPLICATION_CREDENTIALS=""
# FIREBASE_AUTH_EMULATOR_HOST="127.0.0.1:9099"

# Transactional Email (SMTP) Configuration (Required in production)
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_USER="apikey"
SMTP_PASSWORD="secret-smtp-password"
EMAILS_FROM_EMAIL="noreply@brightloop.com"
EMAILS_FROM_NAME="Brightloop Subscription Management"

# Razorpay Payment Gateway (Test Mode / Production)
RAZORPAY_KEY_ID="rzp_test_your_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret"
RAZORPAY_WEBHOOK_SECRET="your_razorpay_webhook_secret"

# Automated In-Process Recurring Billing Scheduler
BILLING_SCHEDULER_ENABLED=True
BILLING_SCHEDULER_INTERVAL_SECONDS=300


